# Supabase project used by elcinema/ (publishable/anon values only).
# Copy to .env and fill in. .env is git-ignored; never put a secret key here.
#
# The VITE_-prefixed copies are what the browser bundle sees. The unprefixed
# names are read by server functions. Keep the pairs identical.
#
# `bun run build` refuses to produce a bundle when the two VITE_ values below
# are empty (see scripts/check-env.mjs) — an env-free build compiles green and
# then throws in the browser on every page.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://PROJECT_REF.supabase.co"

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Server-side only: read by scripts/seed-admin.mjs and
# src/integrations/supabase/client.server.ts. Never in a VITE_-prefixed
# variable, never in the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=""
