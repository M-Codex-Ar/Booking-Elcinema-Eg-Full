# Supabase project used by elcinema/ (publishable/anon values only).
# Copy to .env and fill in. .env is git-ignored; never put a secret key here.
#
# The VITE_-prefixed copies are what the browser bundle sees. The unprefixed
# names are read by server functions. Keep the pairs identical.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://PROJECT_REF.supabase.co"

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Reserved for the ASP.NET Core phase. A service-role key belongs in the server
# environment only, never in a VITE_-prefixed variable.
# SUPABASE_SECRET_KEY=""
